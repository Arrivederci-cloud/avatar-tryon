# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 权重目录（默认 ./weights）
AVATAR_WEIGHTS_DIR=./weights

# 可选：HuggingFace 访问令牌，仅拉取受限仓库时需要
HF_TOKEN=

# 试衣托管接口（--vton-backend api 时必填）
# 权重视为 Apache-2.0 可自托管；托管接口是商业服务，按其条款计费
FASHN_API_KEY=

# 纹理补全托管接口（--edit-backend api 时必填）
# 阿里云百炼 Qwen-Image-Edit，按量计费；权重本身是 Apache-2.0
DASHSCOPE_API_KEY=

# 可选：搭配建议用的 LLM（不在主链路上，缺失时走模板兜底）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
