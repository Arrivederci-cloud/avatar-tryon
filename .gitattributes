# 统一以 LF 存储，避免 Windows 检出后整仓库 diff 抖动
* text=auto eol=lf

# 二进制：禁止任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.safetensors binary
*.pt   binary
*.pth  binary
*.onnx binary
*.glb  binary
*.zip  binary
*.tar  binary

# 依赖锁文件按生成物处理，不计入语言统计
requirements.txt linguist-generated=true
